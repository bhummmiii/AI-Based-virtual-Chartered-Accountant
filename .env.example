# ============================================================
# AI-Based Chartered Accountant - Environment Variables
# ============================================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# ============================================================

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
APP_NAME=AI-Based-Chartered-Accountant
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
SECRET_KEY=your-secret-key-here-change-in-production

# ──────────────────────────────────────────────
# Frontend
# ──────────────────────────────────────────────
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
VITE_APP_TITLE=AI Chartered Accountant

# ──────────────────────────────────────────────
# Backend
# ──────────────────────────────────────────────
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
BACKEND_WORKERS=4
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ──────────────────────────────────────────────
# Database - PostgreSQL
# ──────────────────────────────────────────────
POSTGRES_USER=ca_admin
POSTGRES_PASSWORD=ca_secure_password
POSTGRES_DB=ca_assistant_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ca_admin:ca_secure_password@localhost:5432/ca_assistant_db

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ──────────────────────────────────────────────
# JWT Authentication
# ──────────────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ──────────────────────────────────────────────
# Google Gemini API
# ──────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-pro
GEMINI_MAX_TOKENS=4096

# ──────────────────────────────────────────────
# Google Translate API
# ──────────────────────────────────────────────
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# ──────────────────────────────────────────────
# OCR Configuration
# ──────────────────────────────────────────────
TESSERACT_CMD=/usr/bin/tesseract
EASYOCR_LANGUAGES=en,hi
OCR_MAX_FILE_SIZE_MB=10

# ──────────────────────────────────────────────
# Nginx
# ──────────────────────────────────────────────
NGINX_PORT=80
NGINX_SSL_PORT=443

# ──────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/app.log

# ──────────────────────────────────────────────
# Email (Optional - for notifications)
# ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
